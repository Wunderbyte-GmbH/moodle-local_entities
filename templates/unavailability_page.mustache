{{!
    @template local_entities/unavailability_page

    Page on which the unavailability of an entity is managed. It looks the same for every entity.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-region="unavailability-page"
    * data-region="unavailability-entity-select"
    * data-region="unavailability-calendar"
    * data-region="unavailability-message"
    * data-region="unavailability-dirty"
    * data-action="unavailability-save"
    * data-action="unavailability-discard"
    * data-action="unavailability-addseries"

    Context variables required for this template:
    * heading - string, heading of the entity on display
    * readonly - bool, the unavailability of this kind of entity is locked for the user, the page only shows it
    * entityselect - object, empty if there is nothing to choose
      * label - string, label of the selection
      * url - string, address of the page, the id of the chosen entity is added as entityid
      * options - list of id, name and selected

    Example context (json):
    {
        "heading": "Unavailability of Room A",
        "readonly": false,
        "dailylimit": {"value": 3, "placeholder": "Default: 2", "canchange": true, "max": 99},
        "planningperiod": {"start": 1796079600, "end": 1798758000, "text": "Planning period: 01/12/2026 – 31/12/2026."},
        "entityselect": {
            "label": "Entity",
            "url": "https://example.org/local/entities/unavailability.php",
            "options": [
                {"id": 1, "name": "Room A (Location)", "selected": true},
                {"id": 2, "name": "Billy Teachy (Person)", "selected": false}
            ]
        }
    }
}}
<div class="local-entities-unavailability" data-region="unavailability-page"
    data-readonly="{{#readonly}}1{{/readonly}}{{^readonly}}0{{/readonly}}"
    {{#planningperiod}}data-period-start="{{start}}" data-period-end="{{end}}"{{/planningperiod}}>
    {{#entityselect}}
        <div class="mb-4" data-region="unavailability-entity-select">
            <label for="unavailability-entity" class="form-label">{{label}}</label>
            <select id="unavailability-entity" class="form-select" data-url="{{url}}">
                {{#options}}
                    <option value="{{id}}"{{#selected}} selected{{/selected}}>{{name}}</option>
                {{/options}}
            </select>
        </div>
    {{/entityselect}}
    <h3 class="h4 mb-2">{{heading}}</h3>
    {{#readonly}}
        <div class="alert alert-info" role="status" data-region="unavailability-locked">
            {{#str}}unavailability_locked, local_entities{{/str}}
        </div>
    {{/readonly}}
    {{#planningperiod}}
        <div class="alert alert-secondary" role="status" data-region="unavailability-planningperiod">{{text}}</div>
    {{/planningperiod}}
    {{#dailylimit}}
        <form class="mb-3" data-region="unavailability-dailylimit" data-max="{{max}}" novalidate>
            <label for="unavailability-dailylimit" class="form-label">{{#str}}dailylimit, local_entities{{/str}}</label>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <div class="local-entities-dailylimit-field">
                    <input type="number" id="unavailability-dailylimit" class="form-control" min="1" max="{{max}}" step="1"
                        value="{{value}}" placeholder="{{placeholder}}"
                        aria-describedby="unavailability-dailylimit-help"{{^canchange}} disabled{{/canchange}}>
                </div>
                {{#canchange}}
                    <button type="submit" class="btn btn-outline-primary">{{#str}}dailylimit_save, local_entities{{/str}}</button>
                {{/canchange}}
                <span class="small" data-region="unavailability-dailylimit-status" aria-live="polite"></span>
            </div>
            <div id="unavailability-dailylimit-help" class="form-text">{{#str}}dailylimit_help, local_entities{{/str}}</div>
        </form>
    {{/dailylimit}}
    <p class="text-muted">{{#str}}unavailability_help, local_entities{{/str}}</p>
    {{^readonly}}
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3" data-region="unavailability-toolbar">
        <button type="button" class="btn btn-primary" data-action="unavailability-save" disabled>
            {{#str}}unavailability_save, local_entities{{/str}}
        </button>
        <button type="button" class="btn btn-secondary" data-action="unavailability-discard" disabled>
            {{#str}}unavailability_discard, local_entities{{/str}}
        </button>
        <button type="button" class="btn btn-outline-secondary" data-action="unavailability-addseries">
            {{#str}}unavailability_addseries, local_entities{{/str}}
        </button>
        <span class="ms-2 fw-bold d-none" data-region="unavailability-dirty">
            {{#str}}unavailability_unsaved, local_entities{{/str}}
        </span>
    </div>
    {{/readonly}}
    <div data-region="unavailability-message" aria-live="polite"></div>
    <div data-region="unavailability-calendar"></div>
</div>
